{
  "compilerOptions": {
   "target": "ES2022",
   "module": "NodeNext",
    "lib": ["ES2020"],
     "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
  "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
     "moduleResolution": "NodeNext",
    "declaration": false,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/index.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}