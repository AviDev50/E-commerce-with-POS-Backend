generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum OrderChannel {
  ONLINE
  POS
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TaxApplyWhen {
  DESTINATION
  ORIGIN_MATCH
  ORIGIN_MISMATCH
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  EXCHANGED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]  @relation("OrderCreatedBy")
  refunds   Refund[] @relation("RefundProcessedBy")
  approvedReturns ReturnRequest[] @relation("ReturnApprovedBy")
  refreshTokens RefreshToken[]

  @@map("users")
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String         @unique
  email         String? 
  cart          Cart?          
  password      String?
  dob           DateTime?       @db.Date
  gender        Gender?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  refreshTokens RefreshToken[]
   wishlistItems WishlistItem[]
   returnRequests ReturnRequest[]
    supportTickets SupportTicket[]

  @@map("customers")
}

model Address {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       AddressType @default(SHIPPING)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  orders     Order[]

  @@map("addresses")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  image    String?
  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")
   taxClassId String?
    taxClass   TaxClass? @relation(fields: [taxClassId], references: [id])

  isReturnable Boolean @default(true)
  returnPolicyText String? @db.Text

  products Product[]

  @@map("categories")
}

model Product {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  description       String?
  sku               String    @unique
  price             Decimal   @db.Decimal(10, 2)
  costPrice         Decimal?  @db.Decimal(10, 2)
  taxClassId        String?
  taxClass          TaxClass? @relation(fields: [taxClassId], references: [id])
  images            String?
  isActive          Boolean   @default(true)
    isReturnable      Boolean?
    returnPolicyText String?  @db.Text
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variants          ProductVariant[]
  orderItems        OrderItem[]
  reviews           Review[]
  cartItems         CartItem[]
    wishlistItems WishlistItem[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  sku        String   @unique
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  images     String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems      OrderItem[]
  attributeValues VariantAttributeValue[]
  cartItems  CartItem[]
  wishlistItems WishlistItem[]
  exchangeReturns ReturnRequest[] @relation("ExchangeVariant")

  @@map("product_variants")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  images     String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  orders        Order[]

  @@map("coupons")
}

model Order {
  id          String       @id @default(uuid())
  orderNumber String       @unique
  channel     OrderChannel @default(ONLINE)
  status      OrderStatus  @default(PENDING)

  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  createdById String?
  createdBy   User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  addressId   String?
  address     Address?     @relation(fields: [addressId], references: [id])
  couponId    String?
  coupon      Coupon?      @relation(fields: [couponId], references: [id])

  subtotal    Decimal      @db.Decimal(10, 2)
  tax         Decimal      @default(0) @db.Decimal(10, 2)
  discount    Decimal      @default(0) @db.Decimal(10, 2)
  total       Decimal      @db.Decimal(10, 2)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deliveredAt DateTime?

  orderItems  OrderItem[]
  payments    Payment[]
  refunds     Refund[]
  exchangeReturnRequests ReturnRequest[] @relation("ExchangeOrder")

  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int
  price       Decimal         @db.Decimal(10, 2)
  taxAmount   Decimal         @default(0) @db.Decimal(10, 2)
  taxBreakdown Json?
  subtotal    Decimal         @db.Decimal(10, 2)
  returnedQty Int @default(0)

  returnRequests ReturnRequest[]
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  transactionRef String?
  createdAt      DateTime      @default(now())

  @@map("payments")
}

model Refund {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  amount        Decimal      @db.Decimal(10, 2)
  reason        String
  status        RefundStatus @default(PENDING)
  processedById String?
  processedBy   User?        @relation("RefundProcessedBy", fields: [processedById], references: [id])
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("refunds")
}

model StoreSettings {
  id           String   @id @default(uuid())
  businessName String
  logoUrl      String?
  email        String?
  phone        String?
  address      String?
  state        String?
   country      String?
  currency     String   @default("INR")
  taxPercent   Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt

  @@map("store_settings")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model Attribute {
  id        String   @id @default(uuid())
  name      String   @unique   // e.g. "Color", "Size"
  createdAt DateTime @default(now())

  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  value       String    // e.g. "Red", "M"

  variantLinks VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model VariantAttributeValue {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Banner {
  id         String   @id @default(uuid())
  title      String?
  imageUrl   String
  linkUrl    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("banners")
}

model WishlistItem {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([customerId, productId, variantId])
  @@map("wishlist_items")
}

model TaxClass {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())

  rates     TaxRate[]
  products  Product[]
  categories Category[]

  @@map("tax_classes")
}

model TaxRate {
  id          String       @id @default(uuid())
  taxClassId  String
  taxClass    TaxClass     @relation(fields: [taxClassId], references: [id])
  country     String
  state       String?
  name        String
  rate        Decimal      @db.Decimal(5, 2)
  appliesWhen TaxApplyWhen @default(DESTINATION)
  isCompound  Boolean      @default(false)
  priority    Int          @default(0)
  createdAt   DateTime     @default(now())

  @@map("tax_rates")
}

model ReturnRequest {
  id          String       @id @default(uuid())

  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])

  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])

  type        ReturnType   @default(RETURN)
  reason      String
  reasonNote  String?
  images      String?
  quantity    Int
  status      ReturnStatus @default(REQUESTED)

  // Exchange ke case mein hi ye do fields use honge
  exchangeVariantId String?
  exchangeVariant    ProductVariant? @relation("ExchangeVariant", fields: [exchangeVariantId], references: [id])
  exchangeOrderId    String?
  exchangeOrder      Order?          @relation("ExchangeOrder", fields: [exchangeOrderId], references: [id])

  refund      Refund?

  approvedById String?
  approvedBy   User?   @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("return_requests")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String              @id @default(uuid())
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  title       String
  description String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("support_tickets")
}

enum PageType {
  ABOUT_US
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  RETURN_AND_REFUND_POLICY
}

model StorePage {
  id        String   @id @default(uuid())
  type      PageType @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("store_pages")
}